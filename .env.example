# RecallCare configuration. Copy to `.env` and fill in. `.env` is gitignored — never commit it.
# Every value below is optional for `make demo` (mock LLM + simulator channel run with zero credentials).

# ---------------------------------------------------------------- LLM
# mock | gateway | openrouter
LLM_PROVIDER=mock
# Organisers' Bedrock-backed gateway (names match the official starter kit)
LLM_GATEWAY_URL=https://api.softwaresystems.app
LLM_GATEWAY_API_KEY=
LLM_MODEL=global.anthropic.claude-sonnet-4-5-20250929-v1:0
# Some gateway builds ignore the system role; true = fold the system prompt into the first user turn
LLM_GATEWAY_SYSTEM_IN_USER=false
# The gateway's WAF rejects bodies over ~8 KiB (403). Requests are trimmed to stay under this.
LLM_MAX_REQUEST_BYTES=7500
LLM_TIMEOUT_S=60
LLM_MAX_OUTPUT_TOKENS=600
# OpenRouter fallback (used automatically if the gateway fails twice, or directly with LLM_PROVIDER=openrouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-4.5
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ---------------------------------------------------------------- Channel
# simulator | whatsapp  (can also be switched live from the dashboard)
CHANNEL=simulator
# Comma-separated E.164 numbers. The channel adapter REFUSES to send anywhere else.
WHATSAPP_ALLOWLIST=
# Map demo patients to real allowlisted phones: patient_id:+65XXXXXXXX,patient_id:+65XXXXXXXX
DEMO_PHONE_MAP=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Copy from the sample curl on Meta's API Setup page, e.g. vNN.N — not hard-coded on purpose
WHATSAPP_GRAPH_VERSION=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Custom template (config/whatsapp_templates.yaml). Until Meta approves it, use hello_world.
WHATSAPP_TEMPLATE_NAME=recall_reminder
WHATSAPP_TEMPLATE_APPROVED=false

# ---------------------------------------------------------------- App
# Staff dashboard login (choose your own; the dashboard shows patient data, even though it's synthetic)
DASHBOARD_USER=staff
DASHBOARD_PASSWORD=
# Long random string used to sign session cookies
SESSION_SECRET=
DATABASE_PATH=data/recallcare.db
CHECKPOINT_DB_PATH=data/checkpoints.db
CLINIC_CONFIG=config/clinics/dental.yaml
# Freeze "today" for repeatable demos (YYYY-MM-DD). Blank = real date in Asia/Singapore.
AS_OF_DATE=
# Public HTTPS base URL (set on the server, e.g. https://1-2-3-4.sslip.io)
PUBLIC_BASE_URL=
LOG_LEVEL=INFO
# Inbound rate limit per sender (messages per minute)
INBOUND_RATE_PER_MIN=10

# ---------------------------------------------------------------- Deploy (laptop side only)
DEPLOY_HOST=
DEPLOY_USER=ubuntu
DEPLOY_SSH_KEY=.secrets/lightsail_rsa
GITHUB_REPO_URL=
