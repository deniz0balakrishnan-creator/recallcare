# Secrets — never commit
.env
.env.*
!.env.example
.secrets/
*.pem
*.key
id_rsa*
*_rsa
*_rsa.pub

# Vendor clones (read-only reference)
vendor/

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# Runtime data (regenerated by `make seed`)
data/*.db
data/*.db-*
data/*.sqlite*
*.log

# OS / editor
.DS_Store
.vscode/
.idea/

# Generated eval traces (report.md/json are committed on purpose)
evals/runs/
docs/.*.typ

# Local tooling
.claude/
